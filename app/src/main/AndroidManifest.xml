<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        实验七：在实验六的 Fragment 应用上增加音乐播放器。
        Android 13（API 33）起读取音乐改用 READ_MEDIA_AUDIO；
        Android 12 及以下仍用 READ_EXTERNAL_STORAGE，通过 maxSdkVersion 限定。
        通知栏显示歌曲名还需要 POST_NOTIFICATIONS 运行时权限。
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- 主界面：应用标题就是姓名 + 学号，内部用底部导航切换三个 Fragment -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            实验七：音乐播放器。
            播放逻辑在 MusicPlayerService 中，Activity 只负责绑定服务和显示；
            configChanges 避免旋转屏幕时 Activity 重建导致解除绑定、音乐中断。
        -->
        <activity
            android:name=".lab7.MusicPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity" />

        <!-- 实验七：音乐播放服务。只允许应用内绑定，不对外导出。 -->
        <service
            android:name=".lab7.MusicPlayerService"
            android:exported="false" />
    </application>

</manifest>
