<?xml version="1.0" encoding="utf-8"?>
<!--
    实验四主界面：显示玩家信息，并提供“修改个人信息”和“翻牌游戏”两个入口。
    所有可见文字都来自 strings.xml，布局中不出现字符串字面量。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/app_name"
        app:titleTextAppearance="@style/TextAppearance.MaterialComponents.Headline6"
        app:titleTextColor="@color/white" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center_horizontal"
                android:background="@color/avatar_bg"
                android:contentDescription="@string/avatar_desc"
                android:padding="26dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_avatar_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApplication.Circle"
                app:strokeColor="@color/card_surface"
                app:strokeWidth="3dp" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyApplication.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_name" />

                        <TextView
                            android:id="@+id/tv_name_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="杨文才" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_gender" />

                        <TextView
                            android:id="@+id/tv_gender_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="男" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_student_id" />

                        <TextView
                            android:id="@+id/tv_student_id_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="2024110144" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_phone" />

                        <TextView
                            android:id="@+id/tv_phone_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="13800138000" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_email" />

                        <TextView
                            android:id="@+id/tv_email_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="2024110144@sicnu.edu.cn" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_hobbies" />

                        <TextView
                            android:id="@+id/tv_hobbies_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            android:maxLines="2"
                            tools:text="阅读、游戏" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_high_score" />

                        <TextView
                            android:id="@+id/tv_high_score_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            android:textColor="@color/brand_primary"
                            android:textStyle="bold"
                            tools:text="0 分" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_edit_profile"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/edit_profile"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_open_game"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/open_card_game"
                    android:textAllCaps="false"
                    android:textSize="14sp"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
