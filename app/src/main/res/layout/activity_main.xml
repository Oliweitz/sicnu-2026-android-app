<?xml version="1.0" encoding="utf-8"?>
<!--
    实验三主界面：四个按钮分别启动四个二级 Activity。
    标题显示应用名（姓名 + 学号）。
    布局中所有可见文字一律引用 @string，不出现字符串字面量。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:subtitle="@string/main_subtitle"
        app:subtitleTextColor="@color/white"
        app:title="@string/app_name"
        app:titleTextColor="@color/white" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/main_intro"
                android:textSize="16sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_param"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="@string/main_btn_param"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_result"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/main_btn_result"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_camera"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/main_btn_camera"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_stopwatch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="@string/main_btn_stopwatch"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="12dp" />

            <!--
                活动二返回的结果显示在这里。
                freezesText 让 TextView 在旋转屏幕后保住已显示的内容。
            -->
            <TextView
                android:id="@+id/tv_returned_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:background="@color/section1_bg"
                android:freezesText="true"
                android:minHeight="72dp"
                android:padding="16dp"
                android:text="@string/main_result_placeholder"
                android:textSize="16sp" />
        </LinearLayout>
    </ScrollView>

</LinearLayout>
