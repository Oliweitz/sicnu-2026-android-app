<?xml version="1.0" encoding="utf-8"?>
<!--
    第 1 个 Fragment：个人信息。
    同一页面有两种模式：
      - 浏览模式（profile_display）：显示头像、资料和两种玩法的历史最高分；
      - 编辑模式（profile_edit）：显示表单，保存后由 PlayerRepository 序列化写入文件。
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/iv_avatar"
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:background="@color/avatar_bg"
                android:contentDescription="@string/avatar_desc"
                android:padding="26dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_avatar_placeholder"
                app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.MyApplication.Circle"
                app:strokeColor="@color/card_surface"
                app:strokeWidth="3dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btn_pick_avatar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:contentDescription="@string/avatar_change"
                android:visibility="gone"
                app:backgroundTint="?attr/colorSecondary"
                app:fabSize="mini"
                app:srcCompat="@drawable/ic_camera"
                app:tint="@color/white"
                tools:visibility="visible" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_avatar_tip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/avatar_tip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- ==================== 浏览模式 ==================== -->
        <LinearLayout
            android:id="@+id/profile_display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.MyApplication.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_name" />

                        <TextView
                            android:id="@+id/tv_name_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="杨文才" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_gender" />

                        <TextView
                            android:id="@+id/tv_gender_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="男" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_student_id" />

                        <TextView
                            android:id="@+id/tv_student_id_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="2024110144" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_phone" />

                        <TextView
                            android:id="@+id/tv_phone_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="13800138000" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_email" />

                        <TextView
                            android:id="@+id/tv_email_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            tools:text="2024110144@sicnu.edu.cn" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_hobbies" />

                        <TextView
                            android:id="@+id/tv_hobbies_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            android:maxLines="2"
                            tools:text="阅读、游戏" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_high_score_two" />

                        <TextView
                            android:id="@+id/tv_high_score_two_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            android:textColor="@color/brand_primary"
                            android:textStyle="bold"
                            tools:text="0 分" />
                    </LinearLayout>

                    <View style="@style/Widget.MyApplication.InfoDivider" />

                    <LinearLayout style="@style/Widget.MyApplication.InfoRow">

                        <TextView
                            style="@style/Widget.MyApplication.InfoLabel"
                            android:text="@string/label_high_score_three" />

                        <TextView
                            android:id="@+id/tv_high_score_three_value"
                            style="@style/Widget.MyApplication.InfoValue"
                            android:textColor="@color/brand_primary"
                            android:textStyle="bold"
                            tools:text="0 分" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_profile"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="20dp"
                android:text="@string/edit_profile"
                android:textAllCaps="false"
                android:textSize="14sp"
                app:cornerRadius="14dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:text="@string/profile_storage_tip"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- ==================== 编辑模式 ==================== -->
        <LinearLayout
            android:id="@+id/profile_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="gone">

            <TextView
                style="@style/Widget.MyApplication.SectionLabel"
                android:layout_marginTop="22dp"
                android:text="@string/edit_profile_title" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_name"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/name_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_student_id"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/student_id_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_student_id"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_phone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/phone_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_phone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_email"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:hint="@string/email_hint">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                style="@style/Widget.MyApplication.SectionLabel"
                android:layout_marginTop="22dp"
                android:text="@string/gender_title" />

            <RadioGroup
                android:id="@+id/rg_gender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:orientation="horizontal">

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/gender_male" />

                <com.google.android.material.radiobutton.MaterialRadioButton
                    android:id="@+id/rb_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:text="@string/gender_female" />
            </RadioGroup>

            <TextView
                style="@style/Widget.MyApplication.SectionLabel"
                android:layout_marginTop="16dp"
                android:text="@string/hobbies_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_travel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/hobby_travel" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_reading"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/hobby_reading" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_game"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/hobby_game" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cb_shopping"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="@string/hobby_shopping" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_save"
                    style="@style/Widget.MaterialComponents.Button"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_cancel"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    app:cornerRadius="14dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
