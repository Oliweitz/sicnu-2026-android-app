    <color name="card_surface">#FF1E2230</color>
    <color name="text_primary">#FFF2F4FA</color>
    <color name="text_secondary">#FFA8AEC1</color>
    <color name="divider">#FF2C3245</color>
    <color name="avatar_bg">#FF252B40</color>
